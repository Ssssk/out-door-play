{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness/change-status.schema.json",
  "title": "Change status",
  "type": "object",
  "required": ["id", "name", "change_type", "state", "risk_level", "owner", "scope", "gates", "approvals", "blocking_risks"],
  "properties": {
    "id": { "type": "string", "pattern": "^CHG-[A-Z0-9-]+$" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "change_type": { "enum": ["feature", "bugfix", "refactor", "migration", "hotfix", "operation-campaign", "dependency", "infrastructure", "security", "deprecation", "documentation"] },
    "state": {
      "enum": ["draft", "clarifying", "requirements_ready", "design_ready", "approved", "implementing", "verifying", "ready_for_release", "released", "completed", "archived", "cancelled"]
    },
    "risk_level": { "enum": ["unset", "low", "medium", "high", "critical"] },
    "owner": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "gates": {
      "type": "object",
      "required": ["requirements", "design", "implementation", "verification", "security", "uat", "operations", "release", "completion"],
      "additionalProperties": { "enum": ["pending", "passed", "failed", "not-required"] }
    },
    "approvals": { "type": "object" },
    "blocking_risks": { "type": "array", "items": { "type": "string" } }
  }
}
