{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness/acceptance.schema.json",
  "title": "Acceptance criterion",
  "type": "object",
  "required": ["id", "requirementIds", "given", "when", "then", "verification"],
  "properties": {
    "id": { "type": "string", "pattern": "^AC-[A-Z0-9]+-[0-9]{3}$" },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(FR|NFR)-[A-Z0-9]+-[0-9]{3}$" }
    },
    "given": { "type": "string", "minLength": 1 },
    "when": { "type": "string", "minLength": 1 },
    "then": { "type": "string", "minLength": 1 },
    "and": { "type": "array", "items": { "type": "string" } },
    "verification": { "enum": ["automated", "manual", "target-device", "mixed"] }
  }
}
