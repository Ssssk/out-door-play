{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/harness/manifest.schema.json",
  "title": "Harness manifest",
  "type": "object",
  "required": ["schema_version", "name", "language", "distribution_mode", "agent_entrypoints", "stack", "states", "completion_policy", "knowledge_policy"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "language": { "const": "zh-CN" },
    "contract_type": { "type": "string" },
    "distribution_mode": { "enum": ["template", "active"] },
    "agent_entrypoints": { "type": "object" },
    "stack": { "type": "object" },
    "authority_order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_change_files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "completion_policy": {
      "type": "object",
      "required": ["default_fail", "fresh_context_review", "reviewer_write_access", "require_traceability"],
      "properties": {
        "default_fail": { "const": true },
        "fresh_context_review": { "const": true },
        "reviewer_write_access": { "const": false },
        "require_traceability": { "const": true }
      }
    },
    "knowledge_policy": { "type": "object" }
  }
}
