PORT=3100
# 服务端图片上传目录；生产建议挂载持久化卷。
UPLOAD_DIR=uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
ADMIN_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
DATABASE_URL=mysql://chumen:chumen_dev_password@127.0.0.1:3307/chumen_local
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=false
SHADOW_DATABASE_URL=mysql://chumen:chumen_dev_password@127.0.0.1:3307/chumen_shadow
# 附近加油站数据源：腾讯位置服务「地点搜索」（WebService API）。
# key 只能放后端，不得进小程序包；真实值不得提交（.env 已在 .gitignore）。
# 若该 key 开启了 SN 校验，必须同时填写控制台里的 SecretKey，否则请求会报 status 111。
TENCENT_MAP_KEY=
TENCENT_MAP_SECRET=
# 加油站站点定时同步（方案 B：拉取落库，用户请求只读库）。
# ⚠️ 个人开发者 place/search 仅 200 次/日且账号内所有 key 共享额度，
# 因此默认关闭，且默认只同步一个城市（9 次调用/城市/天）。生产建议开启。
STATION_SYNC_ENABLED=false
# 要同步的城市码，逗号分隔；留空则只同步 420100（武汉）
STATION_SYNC_CITIES=
# 单次运行的调用次数上限，默认 60
STATION_SYNC_CALL_BUDGET=
# 手动触发同步令牌：设置后可用 POST /v1/fuel/sync 立即同步，便于发布后验证。
STATION_SYNC_TRIGGER_TOKEN=
# 加油站数据源：百度地图 WebService（STATION_PROVIDER=baidu 时启用）。
# AK 在百度地图开放平台「应用管理」获取；若 AK 开启了 SN 校验，还需填 SK。
BAIDU_MAP_AK=
BAIDU_MAP_SK=

# 普通用户身份。HMAC key 至少 32 个随机字符；真实值不得提交。
IDENTITY_SUBJECT_HMAC_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 只能在非 production 的本地/H5 验证环境显式开启。
DEV_IDENTITY_ENABLED=false
# 仅首次创建超级管理员时临时写入 apps/api/.env，成功后立即删除这三项。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=
