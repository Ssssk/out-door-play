generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Scene {
  drive
  fish
}

enum RouteStatus {
  online
  pending
  offline
}

enum UserStatus {
  normal
  banned
}

enum IdentityProvider {
  wechat
  dev
}

enum FeedType {
  text
  video
}

enum FeedStatus {
  pending
  published
  offline
}

enum RankingStatus {
  online
  pending
  offline
}

enum ReportType {
  route
  user
  fuel
  ugc
}

enum ReportStatus {
  done
  processing
  failed
}

enum AdminUserStatus {
  active
  disabled
}

enum AuditResult {
  success
  rejected
  failed
}

model City {
  code         String        @id @db.VarChar(6)
  name         String        @db.VarChar(32)
  discoveries  Discovery[]
  fuelStations FuelStation[]
  users        User[]
  rankings     Ranking[]
  enabled      Boolean       @default(true)
  scenes       Json?
  // 城市级油价（管理后台维护）：manual 手动录入优先，auto 自动获取，failed 获取失败保留旧值
  oilPrice92   Float?        @map("oil_price_92")
  oilPrice95   Float?        @map("oil_price_95")
  oilPrice0    Float?        @map("oil_price_0")
  oilSource    String?       @map("oil_source") @db.VarChar(8)
  oilUpdatedAt DateTime?     @map("oil_updated_at")
  oilError     String?       @map("oil_error") @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("cities")
}

model Discovery {
  id              String      @id @db.VarChar(64)
  cityCode        String      @map("city_code") @db.VarChar(6)
  scene           Scene
  title           String      @db.VarChar(128)
  rank            Int
  rankTag         String      @map("rank_tag") @db.VarChar(64)
  distanceKm      Float       @map("distance_km")
  lengthKm        Float       @map("length_km")
  elevationM      Int         @map("elevation_m")
  difficulty      String      @db.VarChar(32)
  coverImageUrl   String      @map("cover_image_url") @db.VarChar(255)
  durationLabel   String      @map("duration_label") @db.VarChar(32)
  bestTime        String      @map("best_time") @db.VarChar(64)
  carType         String?     @map("car_type") @db.VarChar(64)
  startPoint      String?     @map("start_point") @db.VarChar(128)
  endPoint        String?     @map("end_point") @db.VarChar(128)
  entryPoint      String?     @map("entry_point") @db.VarChar(128)
  mainArea        String?     @map("main_area") @db.VarChar(128)
  gear            String?     @db.VarChar(128)
  shoreKm         Float?      @map("shore_km")
  depthM          Float?      @map("depth_m")
  description     String      @db.Text
  tags            Json
  latitude        Float
  longitude       Float
  elevationPoints Json?       @map("elevation_points")
  status          RouteStatus @default(online)
  impressions     Int         @default(0)
  clicks          Int         @default(0)
  rankWeight      Int         @default(50) @map("rank_weight")
  city            City        @relation(fields: [cityCode], references: [code], onDelete: Restrict)
  favorites       Favorite[]
  feeds           Feed[]
  auditLogs       AuditLog[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([cityCode, scene])
  @@map("discoveries")
}

model FuelStation {
  id           String   @id @db.VarChar(64)
  cityCode     String   @map("city_code") @db.VarChar(6)
  name         String   @db.VarChar(128)
  brand        String   @db.VarChar(32)
  distanceKm   Float    @map("distance_km")
  openingHours String   @map("opening_hours") @db.VarChar(32)
  price92      Float    @map("price_92")
  price95      Float    @map("price_95")
  latitude     Float
  longitude    Float
  address      String   @db.VarChar(255)
  enabled      Boolean  @default(true)
  city         City     @relation(fields: [cityCode], references: [code], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([cityCode])
  @@map("fuel_stations")
}

model User {
  id           String          @id @db.VarChar(64)
  avatarUrl    String          @map("avatar_url") @db.VarChar(255)
  nickname     String          @db.VarChar(32)
  phone        String?         @db.VarChar(32)
  cityCode     String?         @map("city_code") @db.VarChar(6)
  status       UserStatus      @default(normal)
  lastActiveAt DateTime        @default(now()) @map("last_active_at")
  mileage      Int             @default(0)
  checkins     Int             @default(0)
  adminNote    String?         @map("admin_note") @db.VarChar(255)
  favorites    Favorite[]
  feeds        Feed[]
  identities   UserIdentity[]
  sessions     MobileSession[]
  city         City?           @relation(fields: [cityCode], references: [code], onDelete: SetNull)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model UserIdentity {
  id                  String           @id @db.VarChar(64)
  userId              String           @map("user_id") @db.VarChar(64)
  provider            IdentityProvider
  providerSubjectHash String           @map("provider_subject_hash") @db.Char(64)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@unique([provider, providerSubjectHash])
  @@index([userId])
  @@map("user_identities")
}

model MobileSession {
  id               String    @id @db.VarChar(64)
  userId           String    @map("user_id") @db.VarChar(64)
  accessTokenHash  String    @unique @map("access_token_hash") @db.Char(64)
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, revokedAt])
  @@index([accessExpiresAt])
  @@index([refreshExpiresAt])
  @@map("mobile_sessions")
}

/// 新用户默认昵称候选池：注册时随机取一个未使用的名字，避免「户外玩家xxxx」这类占位昵称。
model NicknamePool {
  id        String   @id @db.VarChar(64)
  name      String   @unique @db.VarChar(32)
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("nickname_pool")
}

model Favorite {
  userId      String    @map("user_id") @db.VarChar(64)
  discoveryId String    @map("discovery_id") @db.VarChar(64)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery   Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([userId, discoveryId])
  @@index([discoveryId])
  @@map("favorites")
}

model Ranking {
  id            String        @id @db.VarChar(64)
  name          String        @db.VarChar(128)
  scene         Scene
  cityCode      String?       @map("city_code") @db.VarChar(6)
  coverageCount Int           @map("coverage_count")
  weight        Int
  status        RankingStatus @default(pending)
  city          City?         @relation(fields: [cityCode], references: [code], onDelete: SetNull)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status, weight])
  @@map("rankings")
}

model Feed {
  id          String     @id @db.VarChar(64)
  authorId    String     @map("author_id") @db.VarChar(64)
  discoveryId String?    @map("discovery_id") @db.VarChar(64)
  type        FeedType
  content     String     @db.VarChar(500)
  reportCount Int        @default(0) @map("report_count")
  status      FeedStatus @default(pending)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discovery   Discovery? @relation(fields: [discoveryId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([authorId])
  @@map("feeds")
}

model ReportTask {
  id        String       @id @db.VarChar(64)
  name      String       @db.VarChar(128)
  type      ReportType
  dateRange String       @map("date_range") @db.VarChar(64)
  dimension String       @db.VarChar(32)
  creator   String       @db.VarChar(64)
  status    ReportStatus @default(processing)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("report_tasks")
}

model AuditLog {
  actionId     String      @id @map("action_id") @db.VarChar(64)
  discoveryId  String?     @map("discovery_id") @db.VarChar(64)
  adminUserId  String?     @map("admin_user_id") @db.VarChar(64)
  operator     String      @db.VarChar(64)
  action       String      @db.VarChar(32)
  resourceType String?     @map("resource_type") @db.VarChar(64)
  resourceId   String?     @map("resource_id") @db.VarChar(64)
  reason       String?     @db.VarChar(200)
  requestId    String?     @map("request_id") @db.VarChar(64)
  result       AuditResult @default(success)
  beforeValue  Json?       @map("before_value")
  afterValue   Json?       @map("after_value")
  discovery    Discovery?  @relation(fields: [discoveryId], references: [id], onDelete: SetNull)
  adminUser    AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([discoveryId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model AdminUser {
  id                String          @id @db.VarChar(64)
  username          String          @unique @db.VarChar(64)
  displayName       String          @map("display_name") @db.VarChar(64)
  passwordHash      String          @map("password_hash") @db.VarChar(255)
  status            AdminUserStatus @default(active)
  failedLoginCount  Int             @default(0) @map("failed_login_count")
  lockedUntil       DateTime?       @map("locked_until")
  passwordChangedAt DateTime        @default(now()) @map("password_changed_at")
  lastLoginAt       DateTime?       @map("last_login_at")
  roles             AdminUserRole[]
  sessions          AdminSession[]
  auditLogs         AuditLog[]
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@map("admin_users")
}

model AdminRole {
  id          String                @id @db.VarChar(64)
  code        String                @unique @db.VarChar(64)
  name        String                @db.VarChar(64)
  description String?               @db.VarChar(255)
  users       AdminUserRole[]
  permissions AdminRolePermission[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("admin_roles")
}

model AdminPermission {
  id          String                @id @db.VarChar(64)
  code        String                @unique @db.VarChar(64)
  description String?               @db.VarChar(255)
  roles       AdminRolePermission[]
  createdAt   DateTime              @default(now()) @map("created_at")

  @@map("admin_permissions")
}

model AdminUserRole {
  adminUserId String    @map("admin_user_id") @db.VarChar(64)
  roleId      String    @map("role_id") @db.VarChar(64)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_roles")
}

model AdminRolePermission {
  roleId       String          @map("role_id") @db.VarChar(64)
  permissionId String          @map("permission_id") @db.VarChar(64)
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id                String    @id @db.VarChar(64)
  adminUserId       String    @map("admin_user_id") @db.VarChar(64)
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfHash          String    @map("csrf_hash") @db.Char(64)
  idleExpiresAt     DateTime  @map("idle_expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  revokedAt         DateTime? @map("revoked_at")
  ipHash            String?   @map("ip_hash") @db.Char(64)
  userAgentHash     String?   @map("user_agent_hash") @db.Char(64)
  adminUser         AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([adminUserId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@map("admin_sessions")
}

model DailyMetric {
  id          Int      @id @default(autoincrement())
  date        DateTime @unique @db.Date
  impressions Int
  clicks      Int
  favorites   Int
  newUsers    Int      @map("new_users")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("daily_metrics")
}

/// 运营配置键值（如小程序「我的」页二维码：key = qrcodes）
model SystemConfig {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}
