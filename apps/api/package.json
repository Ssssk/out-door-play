{
  "name": "@chumen/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "prebuild": "prisma generate",
    "build": "nest build",
    "pretype-check": "prisma generate",
    "type-check": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run --exclude test/**/*.integration.spec.ts --exclude test/**/*.e2e.spec.ts",
    "test:contract": "pnpm build && node dist/scripts/verify-openapi-contract.js",
    "test:integration": "vitest run integration --fileParallelism=false",
    "pretest:e2e": "pnpm build",
    "test:e2e": "vitest run e2e --fileParallelism=false",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "migrate:route-covers": "tsx scripts/migrate-route-covers.ts",
    "migrate:clear-description-placeholder": "tsx scripts/migrate-clear-description-placeholder.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "preadmin:bootstrap": "prisma generate",
    "admin:bootstrap": "tsx prisma/bootstrap-admin.ts",
    "admin:sync-permissions": "tsx prisma/sync-admin-permissions.ts",
    "admin:reset-password": "tsx prisma/reset-admin-password.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "mariadb": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.2.3",
    "@swc/core": "^1.13.5",
    "@swc/helpers": "^0.5.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.8",
    "vitest": "^3.2.4",
    "yaml": "2.9.0"
  }
}
