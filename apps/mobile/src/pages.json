{
  "easycom": {
    "autoscan": true,
    "custom": { "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue" }
  },
  "pages": [
    { "path": "pages/index/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true } },
    { "path": "pages/fuel/index", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true } },
    { "path": "pages/mine/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/route-detail/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/route-map/index", "style": { "navigationStyle": "custom", "disableScroll": true } },
    { "path": "pages/fishing-detail/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/mine-edit/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/favorites/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/about/index", "style": { "navigationStyle": "custom" } }
  ],
  "tabBar": {
    "color": "#6e6862",
    "selectedColor": "#1a1a1a",
    "backgroundColor": "#fffef9",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "出车", "iconPath": "static/icons/tab-drive.png", "selectedIconPath": "static/icons/tab-drive-active.png" },
      { "pagePath": "pages/fuel/index", "text": "加油", "iconPath": "static/icons/tab-fuel.png", "selectedIconPath": "static/icons/tab-fuel-active.png" },
      { "pagePath": "pages/mine/index", "text": "我的", "iconPath": "static/icons/tab-me.png", "selectedIconPath": "static/icons/tab-me-active.png" }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarBackgroundColor": "#fffef9",
    "backgroundColor": "#fffef9",
    "backgroundTextStyle": "dark",
    "rpxCalcMaxDeviceWidth": 960,
    "rpxCalcBaseDeviceWidth": 375,
    "rpxCalcIncludeWidth": 750
  }
}
