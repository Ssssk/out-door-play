/* 出门溜车 · 首页样式（按 Ardot 设计稿精确还原，375px 基准 -> 2x rpx） */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx;
  color: #2D2A26;
  background: radial-gradient(ellipse at -20% -10%, #E2F8A8 0%, #FDF6EA 60%, #FDF6EA 100%);
}

/* 自定义导航栏 */
.navbar {
  width: 100%;
  background: transparent;
}
.navbar-status {
  width: 100%;
}
.navbar-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.brand {
  font-size: 48rpx;
  font-weight: 700;
  color: #2D2A26;
  letter-spacing: -1rpx;
  line-height: 1.1;
}
.brand-underline {
  width: 100rpx;
  height: 15rpx;
  margin-top: -6rpx;
}

.city {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid #E5DDCB;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2D2A26;
}
.city-icon {
  width: 28rpx;
  height: 28rpx;
}

/* Tab 切换 */
.tabs {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
}
.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6E6862;
}
.tab--active {
  color: #CCFF00;
  background: #1A1A1A;
}

/* 路线卡片列表 */
.cards {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 32rpx;
}

.card {
  position: relative;
  width: 100%;
  height: 504rpx;
  border-radius: 32rpx;
  overflow: hidden;
}
.card-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.card-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.35) 0%,
    rgba(0, 0, 0, 0.15) 35%,
    rgba(0, 0, 0, 0.65) 65%,
    rgba(0, 0, 0, 0.85) 100%
  );
}

/* 左上 Top 标签 */
.tag-top {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 48rpx;
  padding: 0 20rpx;
  background: #1A1A1A;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-bolt {
  width: 22rpx;
  height: 22rpx;
}

/* 右上 距离 */
.tag-distance {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 48rpx;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.tag-pin {
  width: 24rpx;
  height: 24rpx;
}

/* 卡片底部标题与三列信息 */
.card-bottom {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 32rpx;
  color: #ffffff;
}
.card-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.card-meta {
  display: flex;
  gap: 16rpx;
}
.meta-item {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.meta-num {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
  color: #ffffff;
}
.meta-unit {
  font-size: 26rpx;
  margin-left: 4rpx;
}
.meta-num--text {
  font-size: 34rpx;
}
.meta-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

/* 底部 TabBar 占位 */
.tabbar-spacer {
  height: 160rpx;
}

/* 底部 TabBar */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 128rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.82);
  display: flex;
  z-index: 100;
}
.tabbar-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #2D2A26;
}
.tabbar-bg {
  display: none;
  position: absolute;
  width: 140rpx;
  height: 64rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.78) 0%, rgba(255,255,255,0.32) 100%);
  border: 1rpx solid rgba(255,255,255,0.9);
  border-radius: 999rpx;
}
.tabbar-item--active .tabbar-bg {
  display: block;
}
.tabbar-item--active .tabbar-text {
  font-weight: 700;
}
.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
  z-index: 1;
}
.tabbar-text {
  font-size: 22rpx;
  line-height: 1;
  color: #2D2A26;
  z-index: 1;
}
